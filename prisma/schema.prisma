// schema.prisma

generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// --- 1. CORE AUTHENTICATION ---
// ------------------------------------------------------------------
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  tokenVersion  Int      @default(0)

  // Empty until the emailed link is clicked; login is refused until then
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Set only at sign-up: an account still unconfirmed after it is deleted. Accounts from before verification have none.
  verifyDeadline  DateTime? @map("verify_deadline")

  // Timestamps (Recommended)
  createdAt     DateTime @default(now()) @map("created_at")
  lastLoginAt   DateTime? @map("last_login_at")
  
  // Relations: Direct links to the two user lists
  cities         City[]
  shoppingList   UserShoppingListItem[]

  @@map("users")
}

// ------------------------------------------------------------------
// --- 2. CITY LOOKUP TABLE (Stores City Details) ---
// ------------------------------------------------------------------
model City {
  id            Int      @id @default(autoincrement())
  name          String
  country       String
  region        String? // State or region (English), tells same-named places apart
  latitude      Decimal // Stores the coordinate value
  longitude     Decimal // Stores the coordinate value

  // Relation to User
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A saved place is identified by its coordinates, so two different places with the same name can both be saved
  @@unique([userId, latitude, longitude])
  
  @@map("cities")
}

// ------------------------------------------------------------------
// --- 3. JUNCTION TABLES (The User's Lists) ---
// ------------------------------------------------------------------

// B. Shopping List
model UserShoppingListItem {
  itemId        Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
     
  // Specific data for this list item
  category      String
  name          String   
  quantity      Decimal
  measure       String
  isPurchased   Boolean  @default(false) @map("is_purchased")
  createdAt     DateTime @default(now()) @map("created_at")
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_shopping_list_items")
  @@unique([userId, name])
}

// ------------------------------------------------------------------
// --- 4. Push Subscription Info ---
// ------------------------------------------------------------------

model PushSubscription {
  id         Int      @id @default(autoincrement())
  endpoint   String   @unique
  p256dh     String
  auth       String
  latitude   Float
  longitude  Float
  city       String?
  country    String?
  notifyHour Int      @default(6) // UTC hour (0-23) the daily alert cron should send to this subscription
  lang       String   @default("en") // language of the notification text, follows the site language
  createdAt  DateTime @default(now())
}